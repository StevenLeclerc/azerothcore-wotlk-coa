#
# Ascension local-client compatibility
#

[worldserver]

# Enable the compatibility packet filter.
AscensionCompat.Enable = 1

# Apply the Ascension protocol settings to remote connections as well as loopback
# (world headers, extension opcodes, ping interval, spell-modifier layout, class-10 mapping).
# Enable only on realms dedicated to the matching Ascension client build.
# Authentication proofs and packet size checks remain required. Restart to apply.
AscensionCompat.AllowRemoteClients = 0

# This Ascension client keeps world packet headers plaintext after its valid
# CMSG_AUTH_SESSION proof. Remote use also requires AllowRemoteClients above.
AscensionCompat.PlaintextWorldHeaders = 1

# Ascension's classless character creator submits reserved WotLK class ID 10.
# Use a stock warrior shell until the classless progression backend is added.
AscensionCompat.MapClass10ToWarrior = 1

# Log each consumed extension packet during protocol discovery.
AscensionCompat.LogConsumedPackets = 1

# Ascension character screen: enable/disable (activate/deactivate) and the
# per-account character list sort order.
# Requests: CMSG 0x072E / 0x072F / 0x0772.
# Responses: SMSG 0x075E / 0x075F / 0x0760 / 0x076F / 0x0770 / 0x0771.
AscensionCompat.CharacterSelectionEnable = 1

# Maximum simultaneously active characters per account (1-128).
# Deactivated characters stay stored, are hidden from the standard character
# list and can be re-activated later.
AscensionCompat.CharacterSelectionMaxActive = 10

# Automatically add appearance and vanity entries for items obtained by a character.
AscensionCompat.AutoCollectAppearances = 1

# Solo-server convenience: unlock the complete local appearance catalog. The
# per-category value balances the initial snapshot; remaining appearances are
# streamed afterward to stay below the legacy client's 64 KiB packet limit.
AscensionCompat.UnlockLocalAppearanceCatalog = 1
AscensionCompat.AppearanceCatalogPerCategory = 500

# Solo-server convenience: expose every static VanityCollection entry as account-owned.
# Custom Ascension-only entries still require matching server item/spell templates to deliver.
AscensionCompat.UnlockAllVanity = 1

# If a vanity item has no server item template but its DBC row names a valid spell,
# learn that spell directly when delivery is requested.
AscensionCompat.AllowLearnedSpellDelivery = 1

# Teach owned Vanity mount/companion spells permanently, in small login batches.
# Ownership remains unchanged. Entries without a local spell are not invented.
AscensionCompat.LearnOwnedCompanions = 1

# Solo-server convenience: all riding ranks (300/300) and Cold Weather Flying
# from the first login, including level-one characters. No profession grants.
AscensionCompat.MaxRidingFromStart = 1

# Give a character that carries none of the three PvP ruleset auras the PvE set at login,
# because character creation grants no ruleset and the client's selection frame is level- and
# rested-area gated. The PvE set is the shared marker 1004119 plus 9931032, exactly what pressing
# "PvE Mode" applies, so the character also gains the +15% kill experience that marker carries and
# shows its "War Mode" buff alongside "PvE Mode" until the client data is patched.
# Set to 0 to leave such characters on Ruleset.None instead.
AscensionCompat.RulesetLoginDefault = 1

# Local solo scaling. A creature below the player-minus-three floor is raised
# with stock AzerothCore stat curves. Creatures one or two levels below, equal,
# or higher stay unchanged. Friendly NPCs, pets, critters and triggers are not mobs.
AscensionCompat.LevelScaling = 1

# Lower-level quests report the player's level and use the matching QuestXP row.
# Quests already above the player remain higher. Shared quest templates are immutable.
AscensionCompat.QuestLevelScaling = 1

# Extension range derived from the installed client's opcode dispatch table.
# Keep these values decimal because ConfigMgr numeric values are parsed as decimal.
AscensionCompat.FirstExtensionOpcode = 1311
AscensionCompat.LastExtensionOpcode = 2515

# Experimental local Manastorm. Requires the matching character migration and client UI patch.
# Startup-only: solo levels 10-59, three scenes, depths 1-15. Realm level cap is unchanged.
# Enable only with the reviewed installation package; native gameplay acceptance is still required.
Ascension.Manastorm.Enable = 0

#
#    AscensionCompat.HighRiskIsFFA
#        Description: Give the High Risk ruleset an effect on the server.
#                     The three rulesets — War Mode, High Risk and PvE — are
#                     already a player-facing choice, picked from the client's
#                     frame in a rested area, but their auras were pure markers:
#                     only the character selection screen ever read one.
#                     With this enabled, a High Risk character carries the FFA
#                     flag and can be fought by anyone else in High Risk, of
#                     either faction, which is what the ruleset name promises.
#                     Sanctuaries and friendly capital cities are spared by the
#                     core itself.
#        Default:     1 - (enabled)
#                     0 - (High Risk stays a cosmetic marker)

AscensionCompat.HighRiskIsFFA = 1

#
#    AscensionCompat.HighRiskDeathPenalty
#        Description: The price of High Risk. Its selection spell promises that
#                     "any death while in the open world with High-Risk Mode
#                     active will cause you to drop equipped gear, or Fel Com
#                     gold if your gear is insured", and nothing enforced it:
#                     High Risk was an advantage with no matching risk.
#                     Insurance is automatic — the player pays if they can, and
#                     loses a piece of equipment if they cannot. There is no
#                     client frame to sell a policy from, and an opt-in nobody
#                     can see is an opt-in nobody uses.
#                     Battlegrounds, arenas, instances and sanctuaries are
#                     exempt: the spell says open world.
#        Default:     1 - (enabled)

AscensionCompat.HighRiskDeathPenalty = 1

#
#    AscensionCompat.HighRiskDeathLevelGap
#        Description: A level gap of this many levels or more costs nothing.
#                     Being ganked by someone far above you, or squashing
#                     someone far below you, is not the fight this mode is
#                     about: this protects the newcomer and makes ganking
#                     pointless in one rule. 0 disables the exemption.
#        Default:     4

AscensionCompat.HighRiskDeathLevelGap = 4

#
#    AscensionCompat.HighRiskPremiumPerItemLevel
#        Description: Insurance premium in copper, per point of item level
#                     summed over everything worn. Better gear, higher premium,
#                     so the rule stays meaningful at 80 without being crushing
#                     at 11. At the default, a character wearing ten pieces of
#                     item level 15 pays 1 gold 50 silver per death.
#        Default:     100 - (one silver per item level)

AscensionCompat.HighRiskPremiumPerItemLevel = 100

#
#    AscensionCompat.HighRiskLootToKiller
#        Description: Where the lost piece goes when the premium cannot be paid.
#                     Enabled, the very same item — enchantments, durability and
#                     random properties included — is handed to the killer: into
#                     their bags, or into their mailbox if their bags are full or
#                     they logged out between the kill and the release.
#                     A killer that is a creature, or the victim themselves
#                     (a fall, a drowning), leaves nobody to hand it to, and the
#                     piece is destroyed as before.
#                     It is handed over rather than left on the corpse because
#                     the core has no open-world player-corpse loot: the loot
#                     opcode refuses any guid that is not a creature, and the
#                     battleground insignia path needs the victim online and
#                     still a ghost. See CONCEPTION-butin-cadavre.md.
#        Default:     1 - (the killer takes the spoils)
#                     0 - (the piece is destroyed, nobody gains it)

AscensionCompat.HighRiskLootToKiller = 1

#
#    AscensionCompat.RulesetSelectAnywhere
#        Description: choix du jeu de regles (High Risk, War Mode, PvE) partout, hors combat (09/10/2026).
#                     0 : exigence d'origine, en zone de repos seulement (ville ou auberge).
#        Default:     1

AscensionCompat.RulesetSelectAnywhere = 1

#
#    AscensionCompat.HighRiskSettleDelayMs
#        Description: How long after the body is released the penalty waits
#                     before it is applied, in milliseconds.
#                     The penalty is decided when the player dies, armed when
#                     they release, and applied on a later player tick — never
#                     inside Unit::Kill, never inside BuildPlayerRepop, never
#                     while a graveyard teleport is still unacknowledged.
#                     The delay leaves the end-of-tick update batch that carries
#                     the ghost state (health, PLAYER_FLAGS, animation tier)
#                     reach the client before anything else is sent.
#                     0 means: the first tick that finds the player settled.
#        Default:     2000 - (two seconds)

AscensionCompat.HighRiskSettleDelayMs = 2000

#
#    AscensionCompat.DeadPlayerHealthGuard
#        Description: Force a dead player's health back to 0 when something has
#                     raised it.
#                     The core protects that invariant only on the first aura
#                     purge (Unit::setDeathState, JustDied branch). The second
#                     purge, the one Player::KillPlayer triggers by entering
#                     DeathState::Corpse, has no such net, and Unit::ModifyHealth
#                     has no death guard at all. A corpse carrying health makes
#                     the 3.3.5 client leave its dead state while the server
#                     keeps the player dead: rooted, undetected by creatures,
#                     unable to release. See P-031 and P-041.
#                     Every correction is logged as an error, with the player
#                     name and the health found, so the real source can be named
#                     instead of hidden. Turn this off to observe the raw bug.
#        Default:     1 - (restore the invariant, and say so in the log)
#                     0 - (leave the corpse as it is)

AscensionCompat.DeadPlayerHealthGuard = 1

#
#    AscensionCompat.FlyingMountsOnlyInFlyingAreas
#        Description: Montures volantes hors des zones de vol (20/10/2026, R-20261020-1622,
#                     coa-project/docs/DIAG-bot-envol-kattailu-20261020.md). 212 montures portent, apres
#                     chargement, l'aura de vol (207) sans l'attribut qui les reserve a l'Outreterre et au
#                     Norfendre (216 dans le Spell.dbc brut ; 91616-91619 sont deja desarmees au chargement
#                     par OnLoadSpellCustomAttr) : on volait avec en Azeroth et dans la vallee d'Alterac, et les bots
#                     d'un maitre qui les montait volaient avec lui. A 1, hors zone ou le vol est permis
#                     (regle du coeur pour ONLY_FLYING_AREAS : Outreterre, Norfendre avec Vol par temps
#                     froid, hors NO_FLY), la monture s'utilise AU SOL ; arrivee montee dans une zone sans
#                     vol (portail, teleportation), elle est retiree. Exige les lignes spell_script_names
#                     de data/sql/db-world/2026_10_20_01_ascension_montures_vol_zones.sql : sans elles,
#                     l'option ne fait rien. Relue a chaque lancer et changement d'aire (`reload config`).
#        Default:     1 - (au sol hors des zones de vol)
#                     0 - (comportement d'avant : ces montures volent partout hors NO_FLY)

AscensionCompat.FlyingMountsOnlyInFlyingAreas = 1

###################################################################################################
# ARTISANAT (refonte, lot 1) - AscensionArtisanat.cpp
#
#    CoaArtisanat.EveilParMessage
#    CoaArtisanat.AmeliorerParMessage
#        Description: Messages d'addon COA_ATL « EVEIL » et « AMELIORER » de l'atelier (D-PO-10, D-PO-24).
#                     Etapes et couts : table acore_world.coa_artisanat_etape. Coupe : reponse <NOM>_ERR:DESACTIVE.
#        Default:     1

CoaArtisanat.EveilParMessage = 1
CoaArtisanat.AmeliorerParMessage = 1

#    CoaArtisanat.TalentsParMessage
#        Description: Messages COA_ATL « TALENT », « METIER » et « TALENTS? » (lot T0, D-PO-34). Coupe : <NOM>_ERR:DESACTIVE.
#        Default:     1

CoaArtisanat.TalentsParMessage = 1

#    CoaArtisanat.ResignerParMessage
#        Description: Message COA_ATL « RESIGNER:<sac>:<case>:<objet>[:PUR] » (talent Re-signer de l'Astrolabe, 18/10).
#                     « :PUR » (Maj+clic dans l'Atelier) consomme un materiau pur de son metier pour le rang 4 ; sans lui,
#                     aucun pur n'est pris. Coupe : RESIGNER_ERR:DESACTIVE.
#        Default:     1

CoaArtisanat.ResignerParMessage = 1

#    CoaArtisanat.ComposantReserve
#        Description: Talent « Composant d'artisan » (Forge, Cuir, Couture) : les recettes de composant d'artisan exigent
#                     le talent chez le dresseur (trainer_spell.ReqAbility1, fichiers 3-contenu-composant-reserve.sql) et
#                     sont retirees a la connexion aux non-specialistes. 0 : on ne retire rien (retour arriere ; remettre
#                     aussi ReqAbility1 a 0 pour rouvrir le dresseur).
#        Default:     1

CoaArtisanat.ComposantReserve = 1

#    CoaArtisanat.OutilOffert
#        Description: Un humain qui apprend un metier (competence 0 -> 1) recoit l'outil de ce metier s'il n'en a aucun
#                     (sacs, banque, equipement) ; sacs pleins : par courrier. Une fois par metier et par personnage
#                     (table coa_artisanat_outil_offert de la base personnages ; absente : rien n'est donne). Bots exclus.
#                     Lu a chaque apprentissage : `.reload config` suffit. 0 : plus rien n'est donne.
#        Default:     1

CoaArtisanat.OutilOffert = 1

#    CoaArtisanat.Monde.Objet.Vert / .Rare / .Epique
#        Description: Materiaux de monde (D-PO-19) ajoutes au butin des creatures qui ont une table de butin et
#                     rapportent de l'experience au detenteur du butin (ni grises pour lui, ni NO_XP).
#                     0 coupe la qualite. Ids du lot 1 (PartB) : 9101212, 9101213, 9101214.
#                     « Rapporte de l'experience » = Acore::XP::Gain > 0 : Rate.XP.Kill = 0 coupe donc tout,
#                     et une creature a ModExperience 0 ne lache rien. Detenteur bot dans le groupe d'un joueur :
#                     l'objet n'est pose que si le joueur peut l'obtenir (pas en tour par tour, ni sous le seuil,
#                     ni avec un bot maitre du butin). Les bots ne ramassent ni ne tirent ces objets (mod-playerbots).
#        Default:     0
#
#    CoaArtisanat.Monde.Chance.<Categorie>.<Qualite>
#        Description: Chance en pour cent, un tirage independant par qualite. Categories, par priorite :
#                     Boss (rang 3), RareElite (2), Rare (4), Instance (donjon ou raid, rangs 0 et 1),
#                     Elite (1), Ordinaire (0). Rang 5 : rien.
#                     Proposition de PartB validee (D-PO-24), donnee en commentaire a cote de chaque cle.
#        Default:     0
#
#    CoaArtisanat.Monde.Vert.<Categorie>.Min / .Max
#        Description: Nombre de verts poses quand le tirage reussit (rare et epique : 1).
#        Default:     1
#
#    CoaArtisanat.Monde.TauxBots
#        Description: Pour cent des chances quand le detenteur du butin est un bot. 0 : bots exclus (D-PO-23).
#        Default:     0

CoaArtisanat.Monde.Objet.Vert = 0
CoaArtisanat.Monde.Objet.Rare = 0
CoaArtisanat.Monde.Objet.Epique = 0
#    proposition : 4
CoaArtisanat.Monde.Chance.Ordinaire.Vert = 0
#    proposition : 0.3
CoaArtisanat.Monde.Chance.Ordinaire.Rare = 0
#    proposition : 0
CoaArtisanat.Monde.Chance.Ordinaire.Epique = 0
#    proposition : 15
CoaArtisanat.Monde.Chance.Elite.Vert = 0
#    proposition : 2
CoaArtisanat.Monde.Chance.Elite.Rare = 0
#    proposition : 0.1
CoaArtisanat.Monde.Chance.Elite.Epique = 0
#    proposition : 100
CoaArtisanat.Monde.Chance.Rare.Vert = 0
#    proposition : 25
CoaArtisanat.Monde.Chance.Rare.Rare = 0
#    proposition : 1
CoaArtisanat.Monde.Chance.Rare.Epique = 0
#    proposition : 100
CoaArtisanat.Monde.Chance.RareElite.Vert = 0
#    proposition : 100
CoaArtisanat.Monde.Chance.RareElite.Rare = 0
