CoaArtisanat.Monde.Chance.RareElite.Epique = 0
#    proposition : 10
CoaArtisanat.Monde.Chance.Instance.Vert = 0
#    proposition : 1.5
CoaArtisanat.Monde.Chance.Instance.Rare = 0
#    proposition : 0.1
CoaArtisanat.Monde.Chance.Instance.Epique = 0
#    proposition : 100
CoaArtisanat.Monde.Chance.Boss.Vert = 0
#    proposition : 50
CoaArtisanat.Monde.Chance.Boss.Rare = 0
#    proposition : 10
CoaArtisanat.Monde.Chance.Boss.Epique = 0
#    proposition : 1
CoaArtisanat.Monde.Vert.Rare.Min = 1
#    proposition : 2
CoaArtisanat.Monde.Vert.Rare.Max = 1
#    proposition : 2
CoaArtisanat.Monde.Vert.RareElite.Min = 1
#    proposition : 3
CoaArtisanat.Monde.Vert.RareElite.Max = 1
#    proposition : 2
CoaArtisanat.Monde.Vert.Boss.Min = 1
